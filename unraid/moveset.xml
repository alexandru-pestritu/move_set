<?xml version="1.0"?>
<Container version="2">
  <Name>MoveSet</Name>
  <Repository>alehh69/moveset:latest</Repository>
  <Registry>https://hub.docker.com/r/alehh69/moveset</Registry>
  <Branch>
    <Tag>latest</Tag>
    <TagDescription>Latest stable release</TagDescription>
  </Branch>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/alexandru-pestritu/move_set</Support>
  <Project>https://github.com/alexandru-pestritu/move_set</Project>
  <Overview>MoveSet is a personal workout tracker. Build exercise routines by scraping GIFs from fitnessprogramer.com, organize them into workouts, and track sessions with per-set completion. Features: drag-and-drop workout builder, stats dashboard, muscle group tags, exercise detail pages, PWA support.</Overview>
  <Category>Productivity: Tools:</Category>
  <WebUI>http://[IP]:[PORT:3000]</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/alexandru-pestritu/move_set/main/unraid/moveset.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/alexandru-pestritu/move_set/main/client/public/logo.png</Icon>
  <ExtraParams/>
  <Description>MoveSet is a personal workout tracker. Build exercise routines by scraping GIFs from fitnessprogramer.com, organize them into workouts, and track sessions with per-set completion.</Description>
  <Config Name="Web UI Port" Target="3000" Default="3000" Mode="tcp" Description="Port for the web interface" Type="Port" Display="always" Required="true" Mask="false">3000</Config>
  <Config Name="App Data" Target="/data" Default="/mnt/user/appdata/moveset" Mode="rw" Description="Database and GIF storage" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/moveset</Config>
  <Config Name="Username" Target="MOVESET_USERNAME" Default="admin" Description="Login username" Type="Variable" Display="always" Required="true" Mask="false">admin</Config>
  <Config Name="Password" Target="MOVESET_PASSWORD" Default="changeme" Description="Login password" Type="Variable" Display="always" Required="true" Mask="true">changeme</Config>
  <Config Name="JWT Secret" Target="JWT_SECRET" Default="" Description="Secret key for JWT signing (generate with: openssl rand -hex 32)" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="Proxy URL" Target="PROXY_URL" Default="" Description="Optional HTTP proxy for exercise scraping" Type="Variable" Display="advanced" Required="false" Mask="false"/>
</Container>
